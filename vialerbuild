}

function spinner() {
    local pid=$1
    local delay=0.5
    local spinstr='|/-\'
    echo "$pid" > "/tmp/.spinner.pid"
    while [ "$(ps a | awk '{print $1}' | grep $pid)" ]; do
        local temp=${spinstr#?}
        printf " [%c]  " "$spinstr"
        local spinstr=$temp${spinstr%"$temp"}
        # sleep $delay
        printf "\b\b\b\b\b\b"
    done
    printf "    \b\b\b\b"
}

function build_h264 () {
    if [ $H264_SUPPORT = false ]; then
        return
    fi

    echo "Use H264"

    rm -rf $H264_BUILD_DIR

    h264_version="2.0.0";
    h264_url="https://github.com/cisco/openh264/archive/v${h264_version}.tar.gz"
    h264_target_path="$H264_BUILD_DIR/src"

    mkdir -p $h264_target_path

    cd $h264_target_path

    echo "Downloading h264-${h264_version}.tar.gz"
	curl -LO $h264_url
    echo "Using h264-${h264_version}.tar.gz"

    tar zxf "v${h264_version}.tar.gz" --strip 1

    h264_headers_dir="${h264_target_path}/include/wels"
    if [ -d "${h264_headers_dir}" ]; then
        rm -rf "${h264_headers_dir}"
    fi
    mkdir -p "${h264_headers_dir}"

    h264_lipo_args=""
    for arch in "${USE_ARCHS[@]}"; do
        # Map our arch names to actual arch for building
        actual_arch="${arch%%-*}"  # Remove -simulator suffix if present
        
        h264_makefile="Makefile"
        h264_makefile_bak="Makefile.bak"
        h264_prefix="${H264_BUILD_DIR}/build/${arch}"
        h264_log="${h264_prefix}/build.log"

        mkdir -p "${h264_prefix}/logs"

        pushd . > /dev/null

        cd $h264_target_path

        if [ -d "${h264_prefix}" ]; then
            rm -rf ${h264_prefix}
        fi
        mkdir -p  ${h264_prefix}

        echo "Building h264 for ${arch}"

        cp "${h264_makefile}" "${h264_makefile_bak}"

        h264_sed_src="^PREFIX=.*"
        h264_sed_dst="PREFIX=${h264_prefix}"
        h264_sed_dst="${h264_sed_dst//\//\\/}"
        sed -i.deleteme "s/${h264_sed_src}/${h264_sed_dst}/" "${h264_makefile}"
        rm ${h264_makefile}.deleteme

        echo "--- Run make file for ${arch}"
        make OS=ios ARCH=${actual_arch} SDK_MIN=${MIN_IOS_VERSION} v=No >> "${h264_log}"  || exit
        make OS=ios ARCH=${actual_arch} SDK_MIN=${MIN_IOS_VERSION} v=No install >> "${h264_log}" || exit
        make OS=ios ARCH=${actual_arch} SDK_MIN=${MIN_IOS_VERSION} v=No clean >> "${h264_log}" || exit

        mv "${h264_makefile_bak}" "${h264_makefile}"

        popd > /dev/null

        h264_lipo_args="${h264_lipo_args} -arch ${actual_arch} ${H264_BUILD_DIR}/build/${arch}/lib/libopenh264.a"
    done

    echo "Organizing H264 libraries by platform..."
    
    mkdir -p "${H264_BUILD_DIR}/lib/device"
    mkdir -p "${H264_BUILD_DIR}/lib/simulator"

    for arch in "${USE_ARCHS[@]}"; do
        actual_arch="${arch%%-*}"  # Remove -simulator suffix if present
        h264_lib="${H264_BUILD_DIR}/build/${arch}/lib/libopenh264.a"
        
        if [ -f "$h264_lib" ]; then
            if [[ "$arch" == *"-simulator"* ]] || [[ "$arch" == "x86_64" ]]; then
                # Simulator libs
                if [ ! -f "${H264_BUILD_DIR}/lib/simulator/libopenh264.a" ]; then
                    cp "$h264_lib" "${H264_BUILD_DIR}/lib/simulator/libopenh264.a"
                else
                    # Combine multiple simulator archs with lipo
                    xcrun lipo "${H264_BUILD_DIR}/lib/simulator/libopenh264.a" "$h264_lib" -create -output "${H264_BUILD_DIR}/lib/simulator/libopenh264.a.tmp"
                    mv "${H264_BUILD_DIR}/lib/simulator/libopenh264.a.tmp" "${H264_BUILD_DIR}/lib/simulator/libopenh264.a"
                fi
            else
                # Device libs
                if [ ! -f "${H264_BUILD_DIR}/lib/device/libopenh264.a" ]; then
                    cp "$h264_lib" "${H264_BUILD_DIR}/lib/device/libopenh264.a"
                else
                    # Combine multiple device archs with lipo
                    xcrun lipo "${H264_BUILD_DIR}/lib/device/libopenh264.a" "$h264_lib" -create -output "${H264_BUILD_DIR}/lib/device/libopenh264.a.tmp"
                    mv "${H264_BUILD_DIR}/lib/device/libopenh264.a.tmp" "${H264_BUILD_DIR}/lib/device/libopenh264.a"
                fi
            fi
        fi
    done

    echo "--- Copying header files"
    cp -R "${H264_BUILD_DIR}/build/${USE_ARCHS[0]}/include/" "${H264_BUILD_DIR}/include"

    echo "Done compiling openh264 (platform-specific libraries)"
}

function build_ssl () {
     if [ $SSL_SUPPORT = false ]; then
        return
    fi

    echo "Use SSL"

    # Clean up previous build if exists
    rm -rf $SSL_BUILD_DIR/lib
    rm -rf $SSL_BUILD_DIR/include
    rm -rf $SSL_BUILD_DIR/src
    rm -rf $SSL_BUILD_DIR/bin
    rm -rf $SSL_BUILD_DIR/output

    mkdir -p $SSL_BUILD_DIR/lib
    mkdir -p $SSL_BUILD_DIR/include

    # Build for each architecture
    for arch in "${USE_ARCHS[@]}"; do
        echo "Building OpenSSL for ${arch}..."
        
        # Determine platform and actual arch
        if [[ "$arch" == "arm64-simulator" ]]; then
            PLATFORM="iPhoneSimulator"
            ACTUAL_ARCH="arm64"
            SDK_NAME="iphonesimulator"
            MIN_VERSION_FLAG="-mios-simulator-version-min"
            CONFIGURE_TARGET="ios64-cross"
        elif [[ "$arch" == "x86_64" ]]; then
            PLATFORM="iPhoneSimulator"
            ACTUAL_ARCH="x86_64"
            SDK_NAME="iphonesimulator"
            MIN_VERSION_FLAG="-mios-simulator-version-min"
            CONFIGURE_TARGET="ios64-cross"
        else
            PLATFORM="iPhoneOS"
            ACTUAL_ARCH="arm64"
            SDK_NAME="iphoneos"
            MIN_VERSION_FLAG="-miphoneos-version-min"
            CONFIGURE_TARGET="ios64-cross"
        fi

        mkdir -p $SSL_BUILD_DIR/src-${arch}
        
        pushd . > /dev/null
        cd $SSL_BUILD_DIR

        # Download OpenSSL if not already present
        if [ ! -f "OpenSSL_1_1_1w.tar.gz" ]; then
            echo "Downloading openssl-1.1.1w.tar.gz..."
            curl -LO https://github.com/openssl/openssl/archive/refs/tags/OpenSSL_1_1_1w.tar.gz
        fi

        # Extract OpenSSL for this arch
        tar zxf OpenSSL_1_1_1w.tar.gz -C src-${arch} --strip 1

        SDKVERSION=$IOS_SDK_VERSION
        MINIOSVERSION=$MIN_IOS_VERSION
        DEVELOPER=$(xcode-select -print-path)
        SDK_PATH=$(xcrun --sdk ${SDK_NAME} --show-sdk-path)
        TARGETDIR="$SSL_BUILD_DIR/output/${arch}"
        mkdir -p "$TARGETDIR"

        # Set CFLAGS and LDFLAGS to ensure the SDK and headers are found
        export CROSS_TOP="${DEVELOPER}/Platforms/${PLATFORM}.platform/Developer"
        export CROSS_SDK="${PLATFORM}${SDKVERSION}.sdk"
        export BUILD_TOOLS="${DEVELOPER}"
        export CC="$(xcrun --sdk ${SDK_NAME} -find clang)"
        export CFLAGS="-arch $ACTUAL_ARCH -isysroot $SDK_PATH ${MIN_VERSION_FLAG}=$MINIOSVERSION"
        export LDFLAGS="-arch $ACTUAL_ARCH -isysroot $SDK_PATH"

        echo "Building OpenSSL for $PLATFORM $SDKVERSION $ACTUAL_ARCH..."

        cd src-${arch}

	BITCODE_FLAG=""
	if [ $HAS_BITCODE = true ]; then
	    BITCODE_FLAG="-fembed-bitcode"
	fi

        ./Configure ${CONFIGURE_TARGET} no-shared no-dso no-hw no-engine --prefix="$TARGETDIR" \
          --openssldir="$TARGETDIR/ssl" \
	  ${BITCODE_FLAG} \
	  no-async || exit 1

        # Build and install OpenSSL
        make -j$(sysctl -n hw.logicalcpu) || exit 1
        make install_sw || exit 1
        make clean

        popd > /dev/null
    done

    echo "Organizing OpenSSL libraries by platform..."

    # Copy headers from first arch
    cp -R "$SSL_BUILD_DIR/output/${USE_ARCHS[0]}/include/openssl" "$SSL_BUILD_DIR/include/"

    # Organize libraries by platform instead of creating universal binaries
    mkdir -p "$SSL_BUILD_DIR/lib/device"
    mkdir -p "$SSL_BUILD_DIR/lib/simulator"

    for arch in "${USE_ARCHS[@]}"; do
        if [[ "$arch" == *"-simulator"* ]] || [[ "$arch" == "x86_64" ]]; then
            # Simulator libs
            if [ ! -f "$SSL_BUILD_DIR/lib/simulator/libssl.a" ]; then
                cp "$SSL_BUILD_DIR/output/${arch}/lib/libssl.a" "$SSL_BUILD_DIR/lib/simulator/libssl.a"
                cp "$SSL_BUILD_DIR/output/${arch}/lib/libcrypto.a" "$SSL_BUILD_DIR/lib/simulator/libcrypto.a"
            else
                # If we have multiple simulator archs, combine them with lipo
                xcrun lipo "$SSL_BUILD_DIR/lib/simulator/libssl.a" "$SSL_BUILD_DIR/output/${arch}/lib/libssl.a" -create -output "$SSL_BUILD_DIR/lib/simulator/libssl.a.tmp"
                mv "$SSL_BUILD_DIR/lib/simulator/libssl.a.tmp" "$SSL_BUILD_DIR/lib/simulator/libssl.a"
                xcrun lipo "$SSL_BUILD_DIR/lib/simulator/libcrypto.a" "$SSL_BUILD_DIR/output/${arch}/lib/libcrypto.a" -create -output "$SSL_BUILD_DIR/lib/simulator/libcrypto.a.tmp"
                mv "$SSL_BUILD_DIR/lib/simulator/libcrypto.a.tmp" "$SSL_BUILD_DIR/lib/simulator/libcrypto.a"
            fi
        else
            # Device libs
            if [ ! -f "$SSL_BUILD_DIR/lib/device/libssl.a" ]; then
                cp "$SSL_BUILD_DIR/output/${arch}/lib/libssl.a" "$SSL_BUILD_DIR/lib/device/libssl.a"
                cp "$SSL_BUILD_DIR/output/${arch}/lib/libcrypto.a" "$SSL_BUILD_DIR/lib/device/libcrypto.a"
            else
                # If we have multiple device archs, combine them with lipo
                xcrun lipo "$SSL_BUILD_DIR/lib/device/libssl.a" "$SSL_BUILD_DIR/output/${arch}/lib/libssl.a" -create -output "$SSL_BUILD_DIR/lib/device/libssl.a.tmp"
                mv "$SSL_BUILD_DIR/lib/device/libssl.a.tmp" "$SSL_BUILD_DIR/lib/device/libssl.a"
                xcrun lipo "$SSL_BUILD_DIR/lib/device/libcrypto.a" "$SSL_BUILD_DIR/output/${arch}/lib/libcrypto.a" -create -output "$SSL_BUILD_DIR/lib/device/libcrypto.a.tmp"
                mv "$SSL_BUILD_DIR/lib/device/libcrypto.a.tmp" "$SSL_BUILD_DIR/lib/device/libcrypto.a"
            fi
        fi
    done

    # Clean up
    for arch in "${USE_ARCHS[@]}"; do
        rm -rf $SSL_BUILD_DIR/src-${arch}
    done
    rm -rf "$SSL_BUILD_DIR/output"
    
    echo "Done building OpenSSL (platform-specific libraries)"
}

function build_zrtp () {
    echo "Use ZRTP"
	rm -rf $ZRTP_BUILD_DIR
	rm -rf $PJSIP_SRC_DIR/third_party/ZRTP4PJ
    mkdir -p $ZRTP_BUILD_DIR
    pushd . > /dev/null
    cd $ZRTP_BUILD_DIR
    git clone https://github.com/wernerd/ZRTP4PJ
    cd ZRTP4PJ/zsrtp
	sh getzrtp.sh || exit
	cd $ZRTP_BUILD_DIR
	mv ZRTP4PJ $PJSIP_SRC_DIR/third_party
	cd $PJSIP_SRC_DIR/third_party/ZRTP4PJ/build/zsrtp
	sed -i '' -e 's#'~/devhome/pjproject.git'#'"$PJSIP_SRC_DIR"'#' Makefile
	cd ../../zsrtp
	sed -i '' -e 's/#define THIS_FILE "transport_zrtp.c"/#define THIS_FILE "transport_zrtp.c"\
#define DYNAMIC_TIMER 1/' transport_zrtp.c
}

function build_opus () {
    if [ $OPUS_SUPPORT = false ]; then
        return
    fi

    echo "Use Opus"

    rm -rf $OPUS_BUILD_DIR

    opus_version="1.5.2"
    SDKVERSION=$IOS_SDK_VERSION
    MINIOSVERSION=$MIN_IOS_VERSION
    #OPT_CFLAGS="-Ofast -flto"
    #OPT_LDFLAGS="-flto"
    OPT_CFLAGS="-Ofast"
    OPT_LDFLAGS=""

    # Add bitcode flag if enabled
    if [ $HAS_BITCODE = true ]; then
        OPT_CFLAGS="${OPT_CFLAGS} -fembed-bitcode"
        OPT_LDFLAGS="${OPT_LDFLAGS} -fembed-bitcode"
    fi
    
    opus_repo_dir=$OPUS_BUILD_DIR
    opus_output_dir="${opus_repo_dir}/dependencies"
    opus_build_build_dir="${opus_repo_dir}/build"
    opus_src_dir="${opus_build_build_dir}/src"
    opus_inter_dir="${opus_build_build_dir}/built"
    
    xcode_dev_path=`xcode-select -print-path`
    
    mkdir -p "${opus_output_dir}/include"
    mkdir -p "${opus_output_dir}/lib"
    mkdir -p $opus_src_dir
    mkdir -p $opus_inter_dir
    
    cd $opus_src_dir

    # Download Opus if not already present
    if [ ! -e "${opus_src_dir}/opus-${opus_version}.tar.gz" ]; then
        echo "Downloading opus-${opus_version}.tar.gz"
        curl -LO http://downloads.xiph.org/releases/opus/opus-${opus_version}.tar.gz
    fi
    echo "Using opus-${opus_version}.tar.gz"

    tar zxf opus-${opus_version}.tar.gz
    cd "${opus_src_dir}/opus-${opus_version}"

    # Caching for faster compilation
    set +e
    CCACHE=`which ccache`
    if [ $? == "0" ]; then
        echo "Building with ccache: $CCACHE"
        CCACHE="${CCACHE} "
    else
        echo "Building without ccache"
        CCACHE=""
    fi
    set -e

    for arch in "${USE_ARCHS[@]}"; do
        echo "Processing opus for ${arch}..."
        
        # Determine platform and configuration
        if [[ "$arch" == "arm64-simulator" ]]; then
            PLATFORM="iPhoneSimulator"
            ACTUAL_ARCH="arm64"
            SDK_PATH=$(xcrun --sdk iphonesimulator --show-sdk-path)
            EXTRA_CONFIG="--host=aarch64-apple-darwin"
            EXTRA_CFLAGS="-arch arm64 -mios-simulator-version-min=${MINIOSVERSION}"
            export CFLAGS="-arch arm64 -mios-simulator-version-min=${MINIOSVERSION} -isysroot ${SDK_PATH}"
            export LDFLAGS="-arch arm64 -mios-simulator-version-min=${MINIOSVERSION} -isysroot ${SDK_PATH}"
        elif [[ "$arch" == "x86_64" ]]; then
            PLATFORM="iPhoneSimulator"
            ACTUAL_ARCH="x86_64"
            SDK_PATH=$(xcrun --sdk iphonesimulator --show-sdk-path)
            EXTRA_CONFIG="--host=x86_64-apple-darwin --disable-rtcd"
            EXTRA_CFLAGS="-arch x86_64 -mios-simulator-version-min=${MINIOSVERSION}"
            export CFLAGS="-arch x86_64 -mios-simulator-version-min=${MINIOSVERSION} -isysroot ${SDK_PATH}"
            export LDFLAGS="-arch x86_64 -mios-simulator-version-min=${MINIOSVERSION} -isysroot ${SDK_PATH}"
        else
            PLATFORM="iPhoneOS"
            ACTUAL_ARCH="arm64"
            SDK_PATH=$(xcrun --sdk iphoneos --show-sdk-path)
            EXTRA_CONFIG="--host=aarch64-apple-darwin"
            EXTRA_CFLAGS="-arch arm64 -miphoneos-version-min=${MINIOSVERSION}"
            export CFLAGS="-arch arm64 -miphoneos-version-min=${MINIOSVERSION} -isysroot ${SDK_PATH}"
            export LDFLAGS="-arch arm64 -miphoneos-version-min=${MINIOSVERSION} -isysroot ${SDK_PATH}"
        fi

        mkdir -p "${opus_inter_dir}/${PLATFORM}${SDKVERSION}-${arch}.sdk"

        ./configure --disable-shared --enable-static --with-pic --disable-extra-programs --disable-doc --enable-float-approx ${EXTRA_CONFIG} \
        --prefix="${opus_inter_dir}/${PLATFORM}${SDKVERSION}-${arch}.sdk" \
        LDFLAGS="$LDFLAGS ${OPT_LDFLAGS} -fPIE -lSystem" \
        CFLAGS="$CFLAGS ${EXTRA_CFLAGS} ${OPT_CFLAGS} -fPIE -isysroot ${SDK_PATH}"

        make -j4
        make install
        make clean
    done

    echo "Organizing Opus libraries by platform..."

    # Create platform-specific library directories
    mkdir -p "${opus_output_dir}/lib/device"
    mkdir -p "${opus_output_dir}/lib/simulator"

    for arch in "${USE_ARCHS[@]}"; do
        if [[ "$arch" == "arm64-simulator" ]]; then
            PLATFORM="iPhoneSimulator"
        elif [[ "$arch" == "x86_64" ]]; then
            PLATFORM="iPhoneSimulator"
        else
            PLATFORM="iPhoneOS"
        fi

        opus_input_arch_lib="${opus_inter_dir}/${PLATFORM}${SDKVERSION}-${arch}.sdk/lib/libopus.a"
        
        if [ -e $opus_input_arch_lib ]; then
            if [[ "$arch" == *"-simulator"* ]] || [[ "$arch" == "x86_64" ]]; then
                # Simulator libs
                if [ ! -f "${opus_output_dir}/lib/simulator/libopus.a" ]; then
                    cp "$opus_input_arch_lib" "${opus_output_dir}/lib/simulator/libopus.a"
                else
                    # Combine multiple simulator archs with lipo
                    xcrun lipo "${opus_output_dir}/lib/simulator/libopus.a" "$opus_input_arch_lib" -create -output "${opus_output_dir}/lib/simulator/libopus.a.tmp"
                    mv "${opus_output_dir}/lib/simulator/libopus.a.tmp" "${opus_output_dir}/lib/simulator/libopus.a"
                fi
            else
                # Device libs
                if [ ! -f "${opus_output_dir}/lib/device/libopus.a" ]; then
                    cp "$opus_input_arch_lib" "${opus_output_dir}/lib/device/libopus.a"
                else
                    # Combine multiple device archs with lipo
                    xcrun lipo "${opus_output_dir}/lib/device/libopus.a" "$opus_input_arch_lib" -create -output "${opus_output_dir}/lib/device/libopus.a.tmp"
                    mv "${opus_output_dir}/lib/device/libopus.a.tmp" "${opus_output_dir}/lib/device/libopus.a"
                fi
            fi
        fi
    done

    echo "Copying headers..."

    for arch in "${USE_ARCHS[@]}"; do
        if [[ "$arch" == "arm64-simulator" ]]; then
            PLATFORM="iPhoneSimulator"
        elif [[ "$arch" == "x86_64" ]]; then
            PLATFORM="iPhoneSimulator"
        else
            PLATFORM="iPhoneOS"
        fi

        cp -R ${opus_inter_dir}/${PLATFORM}${SDKVERSION}-${arch}.sdk/include/* ${opus_output_dir}/include/

        if [ $? == "0" ]; then
            break
        fi
    done

    echo "Done building Opus (platform-specific libraries)"
}

function download_pjsip () {
    pjsip_url="https://github.com/pjsip/pjproject/archive/${PJSIP_VERSION}.tar.gz"
    pjsip_target_path="$PJSIP_DIR/src"

    mkdir -p $pjsip_target_path

    cd $pjsip_target_path

    echo "Downloading pjsip-${PJSIP_VERSION}.tar.gz"
    curl -LO $pjsip_url
    echo "Using pjsip-${PJSIP_VERSION}.tar.gz"

    tar zxf "${PJSIP_VERSION}.tar.gz" --strip 1
}

function clean_pjsip () {
    if [ $CLEAN_PJSIP_SRC = true ]; then
        echo "Clean PJSIP source: ${CLEAN_PJSIP_SRC}"
        echo "WARNING: About to clean directory: ${BASE_DIR}/pjsip"
        echo "Waiting 5 seconds for sanity check... CTRL-C to abort now"
        sleep 1 && echo "4..." && \
        sleep 1 && echo "3..." && \
        sleep 1 && echo "2..." && \
        sleep 1 && echo "1..." && \
        sleep 1

        rm -rf $PJSIP_DIR
        rm -rf $PJSIP_FINAL_LIB_DIR
        rm -rf "${BASE_DIR}/VialerPJSIP.framework"
        rm -rf "${BASE_DIR}/VialerPJSIP.xcframework"
        rm -rf "${BASE_DIR}/Pod"
        echo "Done cleaning PJSIP source"
        echo "============================="
    fi
}

function config_site () {
    echo "Creating config_site.h"

    if [ -f $PJSIP_CONFIG_SITE_H ]; then
        rm -rf $PJSIP_CONFIG_SITE_H
    fi

    echo "#define PJ_CONFIG_IPHONE 1" >> $PJSIP_CONFIG_SITE_H

    if [ $INDEPENDENT_WEBRTC = true ]; then
        echo "#define PJMEDIA_HAS_SRTP 0" >> $PJSIP_CONFIG_SITE_H
    fi

    if [ $H264_SUPPORT = true ]; then
        echo "#define PJMEDIA_HAS_VIDEO 1" >> $PJSIP_CONFIG_SITE_H
        echo "#define PJMEDIA_HAS_OPENH264_CODEC 1" >> $PJSIP_CONFIG_SITE_H
        echo "#define PJMEDIA_VIDEO_DEV_HAS_OPENGL 1" >> $PJSIP_CONFIG_SITE_H
        echo "#define PJMEDIA_VIDEO_DEV_HAS_OPENGL_ES 1" >> $PJSIP_CONFIG_SITE_H
        echo "#define PJMEDIA_VIDEO_DEV_HAS_IOS_OPENGL 1" >> $PJSIP_CONFIG_SITE_H
        echo "#include <OpenGLES/ES3/glext.h>" >> $PJSIP_CONFIG_SITE_H
    fi

    if [ $HAS_IPV6 = true ]; then
        echo " #define PJ_HAS_IPV6 1" >> $PJSIP_CONFIG_SITE_H
    fi

    while IFS=',' read -ra CONFIG_SITE_OPTION; do
        for i in "${CONFIG_SITE_OPTION[@]}"; do
            echo "#define $i" >> $PJSIP_CONFIG_SITE_H
        done
    done <<< $CONFIG_SITE_OPTIONS

    echo "#include <pj/config_site_sample.h>" >> $PJSIP_CONFIG_SITE_H
    echo "Done creating new config_site.h"
    echo "============================="
}

function build_archs () {
    echo "Building ABIs"

    for arch in "${USE_ARCHS[@]}"; do
        # Use the base arch name for configure function
        if [[ "$arch" == "arm64-simulator" ]]; then
            configure_arm64_sim
        else
            configure_"$arch"
        fi
        _build $arch
        _collect $arch
    done

    echo "Done building the ABIs"
    echo "============================="
}

function configure_arm64 () {
    echo "Configure for arm64 (device)"
    export CFLAGS="-miphoneos-version-min=$MIN_IOS_VERSION"
    export LDFLAGS=
}

function configure_arm64_sim () {
    echo "Configure for arm64 (simulator)"
    export DEVPATH=/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer
    export CFLAGS="-O2 -m64 -isysroot $(xcrun --sdk iphonesimulator --show-sdk-path) -mios-simulator-version-min=$MIN_IOS_VERSION"
    export LDFLAGS="-O2 -m64 -isysroot $(xcrun --sdk iphonesimulator --show-sdk-path) -mios-simulator-version-min=$MIN_IOS_VERSION"
    export MIN_IOS="-mios-simulator-version-min=$MIN_IOS_VERSION"
    export PLATFORM="iPhoneSimulator"
    export SDK_PATH=$(xcrun --sdk iphonesimulator --show-sdk-path)
}

function configure_x86_64 () {
    echo "Configure for x86_64"
    export DEVPATH=/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer
    export CFLAGS="-O2 -m64 -isysroot $(xcrun --sdk iphonesimulator --show-sdk-path) -mios-simulator-version-min=$MIN_IOS_VERSION"
    export LDFLAGS="-O2 -m64 -isysroot $(xcrun --sdk iphonesimulator --show-sdk-path) -mios-simulator-version-min=$MIN_IOS_VERSION"
    export MIN_IOS="-mios-simulator-version-min=$MIN_IOS_VERSION"
    export PLATFORM="iPhoneSimulator"
    export SDK_PATH=$(xcrun --sdk iphonesimulator --show-sdk-path)
}

function _build () {
    pushd . > /dev/null
    cd $PJSIP_SRC_DIR

    mkdir -p $PJSIP_LOGS_DIR

    arch=$1
    arch_log="$PJSIP_LOGS_DIR/$arch.log"

    clean_pjsip_libs $arch

    configure="./configure-iphone"

    if [ $HAS_BITCODE = true ]; then
        export CFLAGS="${CFLAGS} -fembed-bitcode"
    fi

    if [ $SSL_SUPPORT = true ]; then
        configure="$configure --with-ssl=${SSL_BUILD_DIR}"
        export CFLAGS="${CFLAGS} -I${SSL_BUILD_DIR}/include"
        export LDFLAGS="${LDFLAGS} -L${SSL_BUILD_DIR}/lib"
        
        # Copy platform-specific SSL libraries to common location for PJSIP
        ssl_lib_dst="${SSL_BUILD_DIR}/lib/libssl.a"
        crypto_lib_dst="${SSL_BUILD_DIR}/lib/libcrypto.a"
        
        if [[ "$arch" == *"-simulator"* ]] || [[ "$arch" == "x86_64" ]]; then
            ssl_lib_src="${SSL_BUILD_DIR}/lib/simulator/libssl.a"
            crypto_lib_src="${SSL_BUILD_DIR}/lib/simulator/libcrypto.a"
        else
            ssl_lib_src="${SSL_BUILD_DIR}/lib/device/libssl.a"
            crypto_lib_src="${SSL_BUILD_DIR}/lib/device/libcrypto.a"
        fi
        
        if [ ! -f "${ssl_lib_src}" ]; then
            echo "Missing SSL library for ${arch}: ${ssl_lib_src}" >&2
            exit 1
        fi
        
        if [ ! -f "${crypto_lib_src}" ]; then
            echo "Missing Crypto library for ${arch}: ${crypto_lib_src}" >&2
            exit 1
        fi
        
        rm -f "${ssl_lib_dst}" "${crypto_lib_dst}"
        cp "${ssl_lib_src}" "${ssl_lib_dst}"
        cp "${crypto_lib_src}" "${crypto_lib_dst}"
    fi

    if [ $OPUS_SUPPORT = true ]; then
        configure="$configure --with-opus=${OPUS_BUILD_DIR}/dependencies"

        opus_lib_dst="${OPUS_BUILD_DIR}/dependencies/lib/libopus.a"
        if [[ "$arch" == *"-simulator"* ]] || [[ "$arch" == "x86_64" ]]; then
            opus_lib_src="${OPUS_BUILD_DIR}/dependencies/lib/simulator/libopus.a"
        else
            opus_lib_src="${OPUS_BUILD_DIR}/dependencies/lib/device/libopus.a"
        fi

        if [ ! -f "${opus_lib_src}" ]; then
            echo "Missing Opus library for ${arch}: ${opus_lib_src}" >&2
            exit 1
        fi

        mkdir -p "$(dirname "${opus_lib_dst}")"
        rm -f "${opus_lib_dst}"
        cp "${opus_lib_src}" "${opus_lib_dst}"
    fi

    if [ $H264_SUPPORT = true ]; then
        configure="$configure --with-openh264=${H264_BUILD_DIR}"
        export CFLAGS="${CFLAGS} -I${H264_BUILD_DIR}/include"
        export LDFLAGS="${LDFLAGS} -L${H264_BUILD_DIR}/lib"
    fi

    export LDFLAGS="${LDFLAGS} -lstdc++"
    
    # Only set MIN_IOS if it's not already set by configure function
    if [ -z "$MIN_IOS" ]; then
        export MIN_IOS="-miphoneos-version-min=${MIN_IOS_VERSION}"
    fi

    echo "Building PJSIP for $arch"

    cp $PJSIP_CONFIG_SITE_H "$BASE_DIR/pjsip/src/pjlib/include/pj"

    # Use the actual arch (without -simulator suffix) for PJSIP
    actual_arch="${arch%%-*}"
    ARCH="-arch $actual_arch" $configure >> $arch_log 2>&1 || exit

    make dep >> $arch_log 2>&1 &
    spinner $!

    make clean >> $arch_log &
    spinner $!

    make >> $arch_log 2>&1 &
    spinner $!

    if [ $SSL_SUPPORT = true ]; then
        if [ $ENABLE_ZRTP = true ]; then
            cd $PJSIP_SRC_DIR/third_party/ZRTP4PJ/build/zsrtp

            make dep >> $arch_log 2>&1 &
            spinner $!

            make >> $arch_log 2>&1 &
            spinner $!
        fi
    fi

    echo "Done building PJSIP for $arch"
    echo "============================="

    popd > /dev/null

}

function _collect () {
    echo "COLLECT for $1"
    cd $BASE_DIR
    mkdir -p "pjsip/temp/$1"

    # Use the actual arch name (without -simulator suffix) for finding libraries
    actual_arch="${1%%-*}"
    
    for x in `find pjsip/src -name *${actual_arch}*.a`; do
        cp -v ./$x ./pjsip/temp/$1
    done | tee "$BASE_DIR"/pjsip/logs/collect.log

    if [ $INDEPENDENT_WEBRTC = true ]; then
        rm ./pjsip/temp/$1/libsrtp*.a
    fi
}

function _merge () {
    echo "MERGE - Creating platform-specific libraries"
    cd $BASE_DIR

    mkdir -p "$BASE_DIR"/Pod

    # Separate architectures by platform
    DEVICE_ARCHS=()
    SIMULATOR_ARCHS=()
    
    for arch in "${USE_ARCHS[@]}"; do
        if [[ "$arch" == *"-simulator"* ]] || [[ "$arch" == "x86_64" ]]; then
            SIMULATOR_ARCHS+=("$arch")
        else
            DEVICE_ARCHS+=("$arch")
        fi
    done

    # Create device library if we have device architectures
    if [ ${#DEVICE_ARCHS[@]} -gt 0 ]; then
        echo "Creating device library for: ${DEVICE_ARCHS[@]}"
        
        device_a_files=""
        for arch in "${DEVICE_ARCHS[@]}"; do
            device_a_files="${device_a_files} `find ./pjsip/temp/${arch} -name *darwin_ios.a -exec printf '%s ' {} +`"
        done

        if [ $SSL_SUPPORT = true ]; then
            device_a_files="${device_a_files} ${SSL_BUILD_DIR}/lib/device/libssl.a ${SSL_BUILD_DIR}/lib/device/libcrypto.a"
        fi

        if [ $OPUS_SUPPORT = true ]; then
            device_a_files="${device_a_files} ${OPUS_BUILD_DIR}/dependencies/lib/device/libopus.a"
        fi

        if [ $H264_SUPPORT = true ]; then
            device_a_files="${device_a_files} ${H264_BUILD_DIR}/lib/device/libopenh264.a"
        fi

        mkdir -p "$BASE_DIR/Pod/device"
        libtool -o Pod/device/VialerPJSIP.a $device_a_files
    fi

    # Create simulator library if we have simulator architectures
    if [ ${#SIMULATOR_ARCHS[@]} -gt 0 ]; then
        echo "Creating simulator library for: ${SIMULATOR_ARCHS[@]}"
        
        sim_a_files=""
        for arch in "${SIMULATOR_ARCHS[@]}"; do
            sim_a_files="${sim_a_files} `find ./pjsip/temp/${arch} -name *darwin_ios.a -exec printf '%s ' {} +`"
        done

        if [ $SSL_SUPPORT = true ]; then
            sim_a_files="${sim_a_files} ${SSL_BUILD_DIR}/lib/simulator/libssl.a ${SSL_BUILD_DIR}/lib/simulator/libcrypto.a"
        fi

        if [ $OPUS_SUPPORT = true ]; then
            sim_a_files="${sim_a_files} ${OPUS_BUILD_DIR}/dependencies/lib/simulator/libopus.a"
        fi

        if [ $H264_SUPPORT = true ]; then
            sim_a_files="${sim_a_files} ${H264_BUILD_DIR}/lib/simulator/libopenh264.a"
        fi

        mkdir -p "$BASE_DIR/Pod/simulator"
        libtool -o Pod/simulator/VialerPJSIP.a $sim_a_files
    fi
}

function clean_pjsip_libs_temp () {
    rm -rf "$BASE_DIR/pjsip/temp/$arch"
    rm -rf "$BASE_DIR/Pod"
}

function clean_pjsip_libs () {
    arch=$1

    echo "Clean $arch lib directory"

    for src_dir in ${PJSIP_LIB_PATHS[*]}; do
        dir="$PJSIP_SRC_DIR/${src_dir}"
        if [ -d $dir ]; then
            rm -rf $dir
        fi

        dir="$PJSIP_SRC_DIR/${src_dir}-${arch}"
        if [ -d $dir ]; then
            rm -rf $dir
        fi
    done
}

function copy_headers () {
    echo "Copying header files to temporary location"
    cd "$BASE_DIR/pjsip/src"

    find . -path "./third_party" -prune -o -path "./pjsip-apps" -prune -o -path "./include" -prune -o -type f -wholename "*include/*.h*" -exec bash -c 'copy_to_lib_dir "{}"' ';' 2>&1
    if [ $H264_SUPPORT = true ]; then
        find ${H264_BUILD_DIR}/include/wels -type f -exec bash -c 'copy_to_lib_dir "{}"' ';'
    fi

    if [ $OPUS_SUPPORT = true ]; then
        find ${OPUS_BUILD_DIR}/dependencies/include/opus -type f -exec bash -c 'copy_to_lib_dir "{}"' ';'
    fi

    if [ $SSL_SUPPORT = true ]; then
        find ${SSL_BUILD_DIR}/include/openssl -type f -exec bash -c 'copy_to_lib_dir "{}"' ';'

        if [ $ENABLE_ZRTP = true ]; then
            cp ${PJSIP_SRC_DIR}/third_party/ZRTP4PJ/zsrtp/include/ZsrtpCWrapper.h "$BASE_DIR/Pod/vialer-pjsip-include/"
            cp ${PJSIP_SRC_DIR}/third_party/ZRTP4PJ/zsrtp/include/transport_zrtp.h "$BASE_DIR/Pod/vialer-pjsip-include/"
            cp -R ${PJSIP_SRC_DIR}/third_party/ZRTP4PJ/zsrtp/zrtp/zrtp/libzrtpcpp/ "$BASE_DIR/Pod/vialer-pjsip-include/libzrtpcpp/"
        fi
    fi

    cd "$BASE_DIR"
    echo "Done copying header files to temporay location"
    echo "============================="
}

function copy_to_lib_dir () {
    old_path=$1
    new_path=()

    path_parts=(`echo $1 | tr '/' '\n'`)
    for x in "${path_parts[@]}"; do
        if [ "$x" = "include" ] || [ "${#new_path[@]}" -ne "0" ]; then
            new_path+=("$x")
        fi
    done

    new_path="${new_path[@]:1}"
    new_path="${new_path// //}"

    d="$BASE_DIR/Pod/vialer-pjsip-include/"$(dirname $new_path)
    mkdir -p $d
    cp $old_path $d
}

function create_xcframework {
    PRODUCT_NAME="VialerPJSIP"
    XCFRAMEWORK_LOCN="${BASE_DIR}/${PRODUCT_NAME}.xcframework"
    
    echo "Creating XCFramework at $XCFRAMEWORK_LOCN"
    
    # Remove old XCFramework if it exists
    rm -rf ${XCFRAMEWORK_LOCN}
    
    # Prepare headers once (shared by all platforms)
    copy_headers
    PUBLIC_HEADERS_FOLDER_PATH="${BASE_DIR}/Pod/vialer-pjsip-include"
    
    # Separate architectures by platform
    DEVICE_ARCHS=()
    SIMULATOR_ARCHS=()
    
    for arch in "${USE_ARCHS[@]}"; do
        if [[ "$arch" == *"-simulator"* ]] || [[ "$arch" == "x86_64" ]]; then
            SIMULATOR_ARCHS+=("$arch")
        else
            DEVICE_ARCHS+=("$arch")
        fi
    done
    
    # Build xcodebuild command with available libraries
    echo "Creating XCFramework from static libraries..."
    XCODEBUILD_CMD="xcodebuild -create-xcframework"
    
    if [ ${#DEVICE_ARCHS[@]} -gt 0 ] && [ -f "${BASE_DIR}/Pod/device/${PRODUCT_NAME}.a" ]; then
        echo "Adding device library for architectures: ${DEVICE_ARCHS[@]}"
        XCODEBUILD_CMD="${XCODEBUILD_CMD} -library ${BASE_DIR}/Pod/device/${PRODUCT_NAME}.a -headers ${PUBLIC_HEADERS_FOLDER_PATH}"
    fi
    
    if [ ${#SIMULATOR_ARCHS[@]} -gt 0 ] && [ -f "${BASE_DIR}/Pod/simulator/${PRODUCT_NAME}.a" ]; then
        echo "Adding simulator library for architectures: ${SIMULATOR_ARCHS[@]}"
        XCODEBUILD_CMD="${XCODEBUILD_CMD} -library ${BASE_DIR}/Pod/simulator/${PRODUCT_NAME}.a -headers ${PUBLIC_HEADERS_FOLDER_PATH}"
    fi
    
    XCODEBUILD_CMD="${XCODEBUILD_CMD} -output ${XCFRAMEWORK_LOCN}"
    
    echo "Running: $XCODEBUILD_CMD"
    eval $XCODEBUILD_CMD || exit 1
    
    echo ""
    echo "======================================================================"
    echo "SUCCESS! XCFramework created at:"
    echo "  ${XCFRAMEWORK_LOCN}"
    echo "======================================================================"
    echo ""
    
    # Verify the XCFramework
    if [ -d "${XCFRAMEWORK_LOCN}" ]; then
        echo "XCFramework contents:"
        ls -la "${XCFRAMEWORK_LOCN}"
        echo ""
        echo "To use this XCFramework in your Xcode project:"
        echo "  1. Drag ${PRODUCT_NAME}.xcframework into your Xcode project"
        echo "  2. In General → Frameworks, Libraries, and Embedded Content"
        echo "  3. Set it to 'Embed & Sign'"
        echo ""
    fi
}

export -f copy_to_lib_dir

if [ -z ${USE_ARCHS} ]; then
    for arch in "${AVIALABLE_ARCHS[@]}"; do
        USE_ARCHS+=($arch)
    done
fi

if [ $SHOW_HELP = true ]; then
    show_help
else
